---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/main.css';
import Ascii from '../components/Ascii.astro';
import Music from '../components/Music.astro';
import { ANALYTICS } from '../lib/analytics';
import { NAV, SITE, SOCIALS } from '../site';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	/** schema.org structured data for search engines */
	schema?: Record<string, unknown>;
}

const { title, description = SITE.description, type = 'website', schema } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const section = `/${Astro.url.pathname.split('/')[1] ?? ''}/`;
// link-preview image generated by src/pages/og/[...route].png.ts
const route = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index';
const ogImage = new URL(`/og/${route}.png`, Astro.site);
// ponytail: style-src keeps 'unsafe-inline' for Shiki's token colours and the view-transition styles;
// hash them if the highlighter ever stops writing style attributes
const CSP = [
	"default-src 'self'",
	"script-src 'self'",
	"style-src 'self' 'unsafe-inline'",
	// analytics events go to PostHog's ingestion host only
	`connect-src 'self'${ANALYTICS.key ? ` ${ANALYTICS.host}` : ''}`,
	"object-src 'none'",
	"base-uri 'none'",
	"form-action 'none'",
	'upgrade-insecure-requests',
].join('; ');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		{/* site-wide CSP: GitHub Pages can't send headers, so it rides in a meta tag. Built pages
		   only (Vite's dev server needs inline scripts); scripts/check-csp.mjs verifies dist. */}
		{import.meta.env.PROD && <meta http-equiv="content-security-policy" content={CSP} />}
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{/* ?v= busts favicons cached from the old site; bump it when the icon changes */}
		<link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
		<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('rss.xml', Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#0a0b0e" />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content={SITE.title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		{/* a data block, not a script, so the CSP doesn't apply; `<` is escaped so the JSON can't close the tag */}
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />}
		<ClientRouter />
		<Font cssVariable="--font-shoulders" preload />
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-fragment" preload />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label={`${SITE.title}, home`}><span data-wordmark>{SITE.title}</span></a>
			<nav aria-label="Main">
				{NAV.map(({ href, label }) => <a href={href} aria-current={section === href ? 'page' : undefined}>{label}</a>)}
			</nav>
			<div class="header-end">
				<Music />
				<p class="clock" aria-label="Local time in Kolkata"><span>Kolkata</span> <time data-clock>--:--</time></p>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-art"><Ascii art="skyline" /></div>
			<div class="footer-row">
				<p class="quote">“{SITE.quote}”</p>
				<p class="links">
					{SOCIALS.map(({ href, label }) => <a href={href}>{label}</a>)}
					<span>© {new Date().getFullYear()}</span>
				</p>
			</div>
		</footer>

		<script>
			import { startAnalytics } from '../lib/analytics';

			startAnalytics();

			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const NOISE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
			const scramble = (text: string, shown: number) =>
				text.slice(0, shown) +
				[...text.slice(shown)].map((ch) => (ch === ' ' ? ' ' : NOISE[Math.floor(Math.random() * NOISE.length)])).join('');

			/** Resolve an element's text from noise, left to right. */
			const decode = (el: HTMLElement, final: string, ms: number) => {
				const start = performance.now();
				const step = (now: number) => {
					const progress = Math.min(1, (now - start) / ms);
					el.textContent = scramble(final, Math.floor(final.length * progress));
					if (progress < 1) requestAnimationFrame(step);
				};
				requestAnimationFrame(step);
			};

			// the client router swaps the page without reloading, so per-page setup runs on every page-load
			document.addEventListener('astro:page-load', () => {
				if (reduced) return;
				for (const el of document.querySelectorAll<HTMLElement>('[data-decode]')) {
					const final = el.textContent ?? '';
					el.setAttribute('aria-label', final);
					decode(el, final, 650);
				}

				// header wordmark: decodes on hover, and every so often tears for a few frames
				const mark = document.querySelector<HTMLElement>('[data-wordmark]');
				if (!mark) return;
				const final = mark.textContent ?? '';
				const link = mark.parentElement as HTMLElement;
				link.addEventListener('pointerenter', () => decode(mark, final, 320));
				const glitch = () => {
					if (!mark.isConnected) return;
					link.classList.add('is-glitching');
					const i = Math.floor(Math.random() * final.length);
					mark.textContent = final.slice(0, i) + NOISE[Math.floor(Math.random() * NOISE.length)] + final.slice(i + 1);
					setTimeout(() => {
						link.classList.remove('is-glitching');
						mark.textContent = final;
						setTimeout(glitch, 5000 + Math.random() * 7000);
					}, 140);
				};
				setTimeout(glitch, 2500);
			});

			const format = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' });
			const tick = () => {
				const clock = document.querySelector('[data-clock]');
				if (clock) clock.textContent = format.format(new Date());
			};
			document.addEventListener('astro:page-load', tick);

			// the glove cursors (public/cursors) are mapped to actions in CSS; warm the images once on a
			// pointer device so the first hover of each gesture never flashes the keyword fallback
			if (matchMedia('(pointer: fine)').matches) {
				const warm = () => {
					for (const c of ['drag', 'hook', 'point', 'palm', 'splay']) new Image().src = `/cursors/${c}.svg`;
				};
				if ('requestIdleCallback' in window) requestIdleCallback(warm);
				else setTimeout(warm, 1500);
			}
			setInterval(tick, 15000);
		</script>
	</body>
</html>
