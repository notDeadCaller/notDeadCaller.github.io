---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, SECTIONS, type Section } from '../../site';

export async function getStaticPaths() {
	const paths = [];
	for (const section of Object.keys(SECTIONS) as Section[]) {
		const posts = await getPosts(section);
		for (const [i, post] of posts.entries()) {
			paths.push({ params: { section, slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } });
		}
	}
	return paths;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<Post post={post} headings={headings} newer={newer} older={older}>
	<Content />
</Post>
