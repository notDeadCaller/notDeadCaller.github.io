---
import { getCollection } from 'astro:content';
import Ascii from '../components/Ascii.astro';
import Feed from '../components/Feed.astro';
import ProjectList from '../components/ProjectList.astro';
import Base from '../layouts/Base.astro';
import { person } from '../data/resume';
import { getFeed, SITE } from '../site';

const latest = (await getFeed()).slice(0, 5);
const { '@context': context, ...author } = person;
const website = { '@context': context, '@type': 'WebSite', name: SITE.title, url: person.url, description: SITE.description, author };
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort(
	(a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<Base schema={website}>
	<section class="hero">
		<h1 class="sr-only">{SITE.title}</h1>
		<div class="hero-art" data-hands><Ascii art="wordmark" text="h3770 fr13nd" flip={SITE.title} dissolve /></div>
	</section>

	<section class="intro">
		<div class="intro-portrait" aria-hidden="true"><canvas class="ascii" data-portrait></canvas></div>
		<p class="now">
			<span class="live" aria-hidden="true"></span>
			<span>Currently Founding Security Engineer at <a href="https://opzami.com/">Opzami</a></span>
		</p>
		<div class="intro-face">
			<p class="intro-lead">
				I'm aVishek, a cybersec undergrad and systems developer based out of Kolkata, testing and exploring sh*t worth
				probing.
			</p>
			<canvas class="ascii intro-morph" hidden aria-hidden="true"></canvas>
		</div>
		<ul class="intro-links">
			<li><a href="/writeups/">Read the writeups</a></li>
			<li><a href="/resume/">See my resume</a></li>
			<li><a href="https://github.com/notDeadCaller">Code on GitHub</a></li>
			<li><a href="https://www.linkedin.com/in/avishekwithav/">Connect on LinkedIn</a></li>
		</ul>
	</section>

	<section class="section" aria-labelledby="writing">
		<header class="section-head">
			<h2 id="writing">Latest writing</h2>
			<a href="/writeups/">All writeups</a>
		</header>
		{latest.length ? <Feed posts={latest} /> : <p class="empty">Nothing published yet.</p>}
	</section>

	{
		projects.length > 0 && (
			<section class="section" aria-labelledby="projects">
				<header class="section-head">
					<h2 id="projects">Projects</h2>
					<a href="/projects/">All projects</a>
				</header>
				<ProjectList projects={projects} />
			</section>
		)
	}
</Base>

<script>
	import { track } from '../lib/analytics';
	import { portrait, portraitMorph } from '../lib/portrait';

	document.addEventListener('astro:page-load', () => {
		// each click on the wordmark swaps the word (src/lib/art.ts)
		document.querySelector('.hero-art')?.addEventListener('pointerdown', () => track('hero_flip'));

		const still = document.querySelector<HTMLCanvasElement>('canvas[data-portrait]');
		const wrap = document.querySelector<HTMLElement>('.intro-face');
		const lead = wrap?.querySelector<HTMLElement>('.intro-lead');
		const morph = wrap?.querySelector<HTMLCanvasElement>('.intro-morph');
		if (!still || !wrap || !lead || !morph) return;
		portrait(still);

		// narrow screens have no room beside the intro: tapping it turns the text into the face instead.
		// purely decorative, so it stays out of the accessibility tree and the text is always there
		const wide = matchMedia('(min-width: 60em)');
		const done = new AbortController();
		document.addEventListener('astro:before-swap', () => done.abort(), { once: true });
		let toggle: ((show: boolean) => void) | undefined;
		let shown = false;
		const reset = () => {
			wrap.classList.remove('is-face');
			wrap.style.height = '';
			setTimeout(() => {
				if (!shown) morph.hidden = true;
			}, 400);
		};
		const set = (show: boolean) => {
			shown = show;
			const from = wrap.offsetHeight;
			if (show) {
				morph.hidden = false;
				morph.style.height = `${Math.max(lead.offsetHeight, Math.round(wrap.clientWidth * 1.2))}px`;
				toggle ??= portraitMorph(morph, lead, (state) => state === 'text' && !shown && reset());
				wrap.classList.add('is-face');
				track('portrait_morph');
			}
			// animate between two fixed heights; auto comes back once the text has settled
			wrap.style.height = `${from}px`;
			void wrap.offsetHeight;
			wrap.style.height = `${show ? morph.offsetHeight : lead.offsetHeight}px`;
			toggle?.(show);
		};
		wrap.addEventListener('click', () => !wide.matches && set(!shown), { signal: done.signal });
		wide.addEventListener('change', () => {
			if (!shown) return;
			shown = false;
			toggle?.(false);
			reset();
		}, { signal: done.signal });
	});
</script>

<style>
	.hero {
		position: relative;
		margin-inline: calc(var(--gutter) * -1);
	}

	.hero-art {
		position: relative;
		height: clamp(15rem, 42vw, 34rem);
	}

	.intro {
		display: grid;
		gap: 2rem 4rem;
		margin: 3rem 0 0;
	}

	/* the morph canvas takes no display value, so [hidden] and the wide-screen rule keep working */
	.intro-portrait canvas,
	.intro-morph {
		width: 100%;
		height: 100%;
		font-family: var(--font-mono);
	}

	.intro-portrait canvas {
		display: block;
	}

	/* on narrow screens the intro text is the switch for the portrait */
	.intro-face {
		position: relative;
		overflow: hidden;
		transition: height 0.9s cubic-bezier(0.65, 0, 0.35, 1);
	}

	@media (max-width: 59.99em) {
		.intro-portrait {
			display: none;
		}

		.intro-face {
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
		}
	}

	.intro-lead,
	.intro-morph {
		transition: opacity 0.3s;
	}

	.intro-morph {
		position: absolute;
		top: 0;
		left: 0;
		opacity: 0;
		pointer-events: none;
	}

	.intro-face.is-face .intro-lead {
		opacity: 0;
	}

	.intro-face.is-face .intro-morph {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.intro-face {
			transition: none;
		}
	}

	.now {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 -1rem;
		font: 0.8125rem var(--font-mono);
		color: var(--muted);
	}

	.now a {
		color: var(--accent);
		text-decoration: none;
	}

	/* a small status light, like an online indicator on a HUD */
	.live {
		flex: none;
		width: 0.5rem;
		height: 0.5rem;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
		clip-path: polygon(0 0, 100% 0, 100% 60%, 60% 100%, 0 100%);
		animation: pulse 2.4s ease-in-out infinite;
	}

	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	.intro-lead {
		max-width: 30ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 400;
		line-height: 1.25;
		color: var(--text-strong);
	}

	.intro-links {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.intro-links a {
		display: flex;
		justify-content: space-between;
		padding: 0.7rem 0;
		color: var(--text);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
	}

	.intro-links a::after {
		content: '↗';
		color: var(--muted);
		transition: transform 0.2s, color 0.2s;
	}

	.intro-links a:hover {
		color: var(--accent);
	}

	.intro-links a:hover::after {
		color: var(--accent);
		transform: translate(2px, -2px);
	}

	/* wide screens: portrait | lead | links. Last in the file so it overrides the base rules */
	@media (min-width: 60em) {
		.intro {
			grid-template-columns: 17rem minmax(0, 2fr) minmax(0, 1fr);
			/* the lead sits centred against the link list, its lines between the list's borders */
			align-items: center;
		}

		.intro-portrait {
			display: block;
			grid-row: 1 / span 2;
			align-self: end;
			height: 21rem;
			/* a soft plate of background so the hero's falling characters don't run through the face */
			background: var(--bg);
			box-shadow: 0 0 2rem 1.5rem var(--bg);
		}

		.now {
			grid-column: 2 / -1;
		}

		.intro-face {
			grid-column: 2;
		}

		.intro-links {
			grid-column: 3;
		}

		.intro-morph {
			display: none;
		}
	}
</style>
