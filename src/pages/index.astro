---
import { getCollection } from 'astro:content';
import Ascii from '../components/Ascii.astro';
import Feed from '../components/Feed.astro';
import ProjectList from '../components/ProjectList.astro';
import Base from '../layouts/Base.astro';
import { getFeed, SITE } from '../site';

const latest = (await getFeed()).slice(0, 5);
const projects = (await getCollection('projects', ({ data }) => data.featured)).sort(
	(a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<Base>
	<section class="hero">
		<h1 class="sr-only">{SITE.title}</h1>
		<div class="hero-art"><Ascii art="wordmark" text={SITE.title} dissolve /></div>
	</section>

	<section class="intro">
		<p class="intro-lead">
			I'm Avishek, a cybersec undergrad and systems developer based out of Kolkata, testing and probing sh*t worth
			looking into.
		</p>
		<ul class="intro-links">
			<li><a href="/writeups/">Read the writeups</a></li>
			<li><a href="/resume/">See my resume</a></li>
			<li><a href="https://github.com/notDeadCaller">Code on GitHub</a></li>
		</ul>
	</section>

	<section class="section" aria-labelledby="writing">
		<header class="section-head">
			<h2 id="writing">Latest writing</h2>
			<a href="/writeups/">All writeups</a>
		</header>
		{latest.length ? <Feed posts={latest} /> : <p class="empty">Nothing published yet.</p>}
	</section>

	{
		projects.length > 0 && (
			<section class="section" aria-labelledby="projects">
				<header class="section-head">
					<h2 id="projects">Projects</h2>
					<a href="/projects/">All projects</a>
				</header>
				<ProjectList projects={projects} />
			</section>
		)
	}
</Base>

<style>
	.hero {
		position: relative;
		margin-inline: calc(var(--gutter) * -1);
	}

	.hero-art {
		position: relative;
		height: clamp(15rem, 42vw, 34rem);
		cursor: crosshair;
	}

	.intro {
		display: grid;
		gap: 2rem 4rem;
		margin: 3rem 0 0;
	}

	@media (min-width: 60em) {
		.intro {
			grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
			align-items: end;
		}
	}

	.intro-lead {
		max-width: 30ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.8vw, 2.1rem);
		font-weight: 400;
		line-height: 1.25;
		color: var(--text-strong);
	}

	.intro-links {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line);
	}

	.intro-links a {
		display: flex;
		justify-content: space-between;
		padding: 0.7rem 0;
		color: var(--text);
		text-decoration: none;
		border-bottom: 1px solid var(--line);
	}

	.intro-links a::after {
		content: '↗';
		color: var(--muted);
		transition: transform 0.2s, color 0.2s;
	}

	.intro-links a:hover {
		color: var(--accent);
	}

	.intro-links a:hover::after {
		color: var(--accent);
		transform: translate(2px, -2px);
	}
</style>
