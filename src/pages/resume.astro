---
import { getCollection } from 'astro:content';
import { resume } from '../data/resume';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Resume" description={`${resume.name}: ${resume.headline}`}>
	<article class="resume">
		<header class="head">
			<h1>{resume.name} <span class="handle">{resume.handle}</span></h1>
			<p class="headline">{resume.headline}</p>
			<p class="contact">
				<span>{resume.location}</span>
				{resume.links.map(({ label, href }) => <a href={href}>{label}</a>)}
			</p>
			<button type="button" class="print no-print" onclick="print()">Download PDF</button>
		</header>

		<p class="summary">{resume.summary}</p>

		<section>
			<h2>Experience</h2>
			{
				resume.experience.map(({ role, org, period, points }) => (
					<div class="entry">
						<div class="entry-head">
							<h3>
								{role} <span class="at">@ {org}</span>
							</h3>
							<span class="period">{period}</span>
						</div>
						<ul>
							{points.map((point) => (
								<li>{point}</li>
							))}
						</ul>
					</div>
				))
			}
		</section>

		<section>
			<h2>Projects</h2>
			{
				projects.map(({ data }) => (
					<div class="entry">
						<div class="entry-head">
							<h3>{data.repo ? <a href={data.repo}>{data.title}</a> : data.title}</h3>
							<span class="period">{data.year}</span>
						</div>
						<p>
							{data.description} <span class="dim">· {data.stack.join(', ')}</span>
						</p>
					</div>
				))
			}
		</section>

		<section>
			<h2>Skills</h2>
			<dl class="skills">
				{
					resume.skills.map(({ group, items }) => (
						<div>
							<dt>{group}</dt>
							<dd>{items.join(' · ')}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section>
			<h2>Education</h2>
			{
				resume.education.map(({ title, org, period }) => (
					<div class="entry-head">
						<h3>
							{title} <span class="at">@ {org}</span>
						</h3>
						<span class="period">{period}</span>
					</div>
				))
			}
		</section>
	</article>
</Base>

<style>
	.resume {
		max-width: 50rem;
		margin: 4.5rem auto 0;
	}

	.head {
		position: relative;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--line);
	}

	h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		font-weight: 700;
		line-height: 0.95;
		text-transform: uppercase;
	}

	.handle {
		display: block;
		margin-top: 0.4rem;
		font: 0.875rem var(--font-mono);
		text-transform: none;
		color: var(--accent);
	}

	.headline {
		margin: 1rem 0 0.5rem;
		font-size: 1.05rem;
		color: var(--text-strong);
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 0;
		font: 0.75rem var(--font-mono);
		color: var(--muted);
	}

	.print {
		position: absolute;
		top: 0;
		right: 0;
		padding: 0.5rem 0.9rem;
		font: 600 0.8125rem var(--font-body);
		color: var(--bg);
		background: var(--accent);
		border: 0;
		cursor: pointer;
	}

	.print:hover {
		color: var(--bg);
		background: var(--accent);
	}

	.summary {
		margin: 1.5rem 0 0;
	}

	section {
		margin-top: 2.5rem;
	}

	h2 {
		margin: 0 0 1.25rem;
		padding-bottom: 0.5rem;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		border-bottom: 1px solid var(--line);
	}

	.entry + .entry {
		margin-top: 1.5rem;
	}

	.entry-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 1rem;
	}

	h3 {
		margin: 0;
		font-size: 1.05rem;
	}

	h3 a {
		color: var(--text-strong);
	}

	.at {
		font-weight: 400;
		color: var(--muted);
	}

	.period {
		font-size: 0.8125rem;
		color: var(--muted);
	}

	.entry ul {
		margin: 0.5rem 0 0;
		padding-left: 1.25rem;
	}

	.entry ul li::marker {
		content: '- ';
		color: var(--accent-2);
	}

	.entry p {
		margin: 0.35rem 0 0;
	}

	.entry p .dim {
		font-size: 0.8125rem;
	}

	.skills {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.5rem 1.5rem;
		margin: 0;
	}

	.skills div {
		display: contents;
	}

	.skills dt {
		font-size: 0.875rem;
		color: var(--accent-2);
	}

	.skills dd {
		margin: 0;
	}

	@media print {
		:global(html),
		:global(body) {
			background: #fff;
			color: #111;
			font-size: 10.5pt;
		}

		:global(.site-header),
		:global(.site-footer),
		:global(.picker),
		.no-print {
			display: none !important;
		}

		.resume {
			margin: 0;
			max-width: none;
		}

		h1,
		h3,
		h3 a,
		.headline,
		.handle,
		.skills dt {
			color: #111;
		}

		a {
			color: #111;
			text-decoration: none;
		}

		.contact,
		.period,
		.at,
		.dim {
			color: #555;
		}

		h2 {
			color: #111;
			border-color: #ccc;
		}

		section,
		.entry {
			break-inside: avoid;
		}
	}
</style>
