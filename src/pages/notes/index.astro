---
import Base from '../../layouts/Base.astro';
import { getPosts, postUrl, SECTIONS, type Post } from '../../site';

const SYSTEM_SIZE = 3; // keep in sync with voyage.ts SYSTEM_SIZE
const notes = await getPosts('notes'); // newest first
const { blurb } = SECTIONS.notes;

// data for the voyage canvas (public notes only in phase 1; locked ones arrive with phase 2)
const sky = notes.map((n) => ({ id: n.id, url: postUrl(n), title: n.data.title, maturity: n.data.maturity, locked: false }));

// scroll track length grows with the number of systems, so you can fly past every note
const systems = Math.max(1, Math.ceil(notes.length / SYSTEM_SIZE));
const trackVh = Math.max(200, systems * 95);

// a short, deterministic "commit hash" per note, for the git-graph list
const shortHash = (s: string) => {
	let h = 2166136261;
	for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
	return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};
const MAT = { seedling: '.', budding: '+', evergreen: '*' } as const;

// build git-graph rows: consecutive notes sharing a primary tag become a branch; everything else
// is a commit on the trunk. ` ` = rail only, the rest carry a note.
type Row = { g: string; kind: 'tip' | 'rail' | 'main' | 'open' | 'commit' | 'close' | 'root'; note?: Post; label?: string };
const primary = (n: Post) => n.data.tags[0];
const rows: Row[] = [{ g: '*', kind: 'tip' }];
for (let i = 0; i < notes.length; ) {
	const tag = primary(notes[i]);
	let j = i;
	while (j < notes.length && primary(notes[j]) === tag) j++;
	const group = notes.slice(i, j);
	if (tag && group.length >= 2) {
		rows.push({ g: '|', kind: 'rail' }, { g: '|\\', kind: 'open', label: tag });
		for (const note of group) rows.push({ g: '| *', kind: 'commit', note });
		rows.push({ g: '|/', kind: 'close' });
	} else {
		for (const note of group) rows.push({ g: '|', kind: 'rail' }, { g: '*', kind: 'main', note });
	}
	i = j;
}
rows.push({ g: '|', kind: 'rail' }, { g: '*', kind: 'root' });
---

<Base title="Notes" description={blurb}>
	{
		notes.length === 0 ? (
			<header class="page-head">
				<h1 data-decode>Notes</h1>
				<p>{blurb} Nothing out here yet — check back soon.</p>
			</header>
		) : (
			<div class="notes-page" data-view="map">
				<button class="view-toggle" type="button" data-toggle>list view</button>

				<section class="voyage" data-voyage style={`height:${trackVh}vh`} aria-hidden="true">
					<div class="viewport">
						<canvas class="ascii sky" data-hands data-notes={JSON.stringify(sky)} />
						<div class="reticle" />
						<figcaption class="focus"><span class="focus-title" /></figcaption>
						<p class="hint">scroll to drift through the systems · a planet at centre is in focus · click to open</p>
					</div>
				</section>

				<div class="list-view">
					<header class="page-head">
						<h1 data-decode>Notes</h1>
						<p>{blurb} Wander the map, or read the log. Brighter planets are more settled ideas.</p>
					</header>
					<div class="graph" role="list">
						{rows.map((r) =>
							r.note ? (
								<a class:list={['grow', r.kind]} href={postUrl(r.note)} role="listitem">
									<span class="rail" data-mat={r.note.data.maturity} aria-hidden="true">{r.g}</span>
									<span class="title">{r.note.data.title}</span>
									<span class="sha">{shortHash(r.note.id)}</span>
									<span class="stage">{r.note.data.maturity}</span>
								</a>
							) : r.kind === 'open' ? (
								<p class="grow open" role="listitem">
									<span class="rail" aria-hidden="true">{r.g}</span>
									<span class="branch">{r.label}</span>
								</p>
							) : (
								<p class:list={['grow', r.kind]} aria-hidden="true">
									<span class="rail">{r.g}</span>
								</p>
							),
						)}
					</div>
				</div>
			</div>
		)
	}
</Base>

<script>
	import { voyage } from '../../lib/voyage';

	document.addEventListener('astro:page-load', () => {
		const page = document.querySelector<HTMLElement>('.notes-page');
		const canvas = document.querySelector<HTMLCanvasElement>('canvas.sky');
		const container = document.querySelector<HTMLElement>('.voyage');
		const focus = document.querySelector<HTMLElement>('.focus-title');
		const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]');
		if (!page || !canvas || !container || !toggle) return;

		// default to the list for reduced motion or a remembered preference; map otherwise
		try {
			const saved = localStorage.getItem('notes:view');
			if (saved === 'list' || (!saved && matchMedia('(prefers-reduced-motion: reduce)').matches)) page.dataset.view = 'list';
		} catch {}
		const setView = (v: string) => {
			page.dataset.view = v;
			toggle.textContent = v === 'map' ? 'list view' : 'map view';
			try {
				localStorage.setItem('notes:view', v);
			} catch {}
		};
		toggle.textContent = page.dataset.view === 'map' ? 'list view' : 'map view';
		toggle.addEventListener('click', () => setView(page.dataset.view === 'map' ? 'list' : 'map'));

		const notes = JSON.parse(canvas.dataset.notes ?? '[]');
		const handle = voyage(canvas, notes, {
			container,
			onFocus: (n) => {
				if (focus) focus.textContent = n ? n.title : '';
				container.classList.toggle('has-focus', !!n);
			},
			onOpen: (n) => {
				if (n.url) location.href = n.url;
			},
		});
		// tidy up before the client router swaps the page out
		document.addEventListener('astro:before-swap', () => handle?.destroy?.(), { once: true });
	});
</script>

<style>
	.view-toggle {
		position: sticky;
		top: 1rem;
		z-index: 5;
		display: block;
		margin-left: auto;
		padding: 0.3rem 0.8rem;
		font: 0.8125rem var(--font-mono);
		color: var(--accent);
		background: var(--bg-raised);
		border: 1px solid var(--line);
	}

	.notes-page[data-view='map'] .list-view { display: none; }
	.notes-page[data-view='list'] .voyage { display: none; }
	.notes-page[data-view='list'] .view-toggle { position: static; margin-bottom: 1.5rem; }

	.voyage {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-top: -4rem;
	}

	.viewport {
		position: sticky;
		top: 0;
		height: 100vh;
		overflow: hidden;
	}

	.sky {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.reticle {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 7rem;
		height: 7rem;
		transform: translate(-50%, -50%);
		opacity: 0.22;
		pointer-events: none;
		transition: opacity 0.2s;
		background:
			linear-gradient(var(--accent), var(--accent)) left top / 0.9rem 1px no-repeat,
			linear-gradient(var(--accent), var(--accent)) left top / 1px 0.9rem no-repeat,
			linear-gradient(var(--accent), var(--accent)) right top / 0.9rem 1px no-repeat,
			linear-gradient(var(--accent), var(--accent)) right top / 1px 0.9rem no-repeat,
			linear-gradient(var(--accent), var(--accent)) left bottom / 0.9rem 1px no-repeat,
			linear-gradient(var(--accent), var(--accent)) left bottom / 1px 0.9rem no-repeat,
			linear-gradient(var(--accent), var(--accent)) right bottom / 0.9rem 1px no-repeat,
			linear-gradient(var(--accent), var(--accent)) right bottom / 1px 0.9rem no-repeat;
	}
	.voyage.has-focus .reticle { opacity: 0.7; }

	.focus {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 4.5rem;
		text-align: center;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 3vw, 1.8rem);
		color: var(--text-strong);
		pointer-events: none;
		min-height: 1.5em;
	}
	.focus-title { border-bottom: 1px solid var(--accent); padding-bottom: 0.1rem; }
	.focus-title:empty { border: 0; }

	.hint {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 1.5rem;
		text-align: center;
		margin: 0;
		font: 0.75rem var(--font-mono);
		color: var(--muted);
		pointer-events: none;
	}

	/* ---- git-graph list ---- */
	.page-head { margin-top: 2rem; }
	.graph { margin-top: 2rem; font-family: var(--font-mono); }

	.grow {
		display: grid;
		grid-template-columns: 3.5ch 1fr auto auto;
		align-items: baseline;
		gap: 0 0.9rem;
		margin: 0;
		text-decoration: none;
	}
	.grow .rail { color: var(--accent-2); white-space: pre; }
	.grow .rail[data-mat='budding'] { color: var(--accent-2); }
	.grow .rail[data-mat='evergreen'] { color: var(--text-strong); }
	a.grow { padding: 0.15rem 0; }
	a.grow:is(:hover, :focus-visible) .title { color: var(--accent); }

	.grow.rail, .grow.tip, .grow.root, .grow.close { line-height: 0.9; }
	.grow.tip .rail, .grow.root .rail { color: var(--text-strong); }

	.title { color: var(--text-strong); font-family: var(--font-body); }
	.sha { font-size: 0.8125rem; color: var(--muted); }
	.stage { font-size: 0.8125rem; color: var(--accent); }

	.open { grid-template-columns: 3.5ch 1fr; }
	.branch { color: var(--accent-2); }
	.branch::before { content: '⎇ '; }

	@media (max-width: 34em) {
		.grow { grid-template-columns: 3.5ch 1fr; }
		.sha { display: none; }
		.stage { grid-column: 2; justify-self: start; font-size: 0.75rem; }
	}
</style>
