---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, isoDate, postUrl, SECTIONS, type Post } from '../../site';
// committed CIPHERTEXT only (see scripts/encrypt-notes.mjs). No plaintext, no titles ship in clear.
import vault from '../../data/encrypted-notes.json';

const SYSTEM_SIZE = 3; // keep in sync with voyage.ts
const notes = await getPosts('notes'); // newest first
const { blurb } = SECTIONS.notes;

// size by content length: short notes are moons that pop open as sticky notes; long ones are big
// planets that open their own page. colour stays with maturity.
const sizeOf = (n: Post) => {
	const len = (n.body ?? '').length;
	return len < 450 ? 'moon' : len < 1100 ? 'planet' : 'giant';
};
const sky = notes.map((n) => ({
	id: n.id,
	url: postUrl(n),
	title: n.data.title,
	maturity: n.data.maturity,
	size: sizeOf(n),
	mode: sizeOf(n) === 'giant' ? 'page' : 'sticky',
	locked: false,
}));
// render each bite-sized note once, hidden, so a sticky note can show it without a round trip
const bodies = await Promise.all(notes.filter((n) => sizeOf(n) !== 'giant').map(async (n) => ({ note: n, Content: (await render(n)).Content })));

// encrypted cores: one red "?" sphere per entry at a system centre. Only id/label/sys are public.
type VaultEntry = { id: string; label?: string; sys?: number; v: number; iter: number; salt: string; iv: string; ct: string };
const cores = (vault as VaultEntry[]).map((e, i) => ({ sys: e.sys ?? i, id: e.id, label: e.label ?? 'encrypted' }));

const systems = Math.max(1, Math.ceil(notes.length / SYSTEM_SIZE), ...cores.map((c) => c.sys + 1));
const trackVh = Math.max(200, systems * 95);
const hasContent = notes.length > 0 || cores.length > 0;

// a short diegetic coordinate per note for the sticky header: SYS-NN · SIZE
const coordOf = new Map(
	notes.map((n, i) => [n.id, `SYS-${String(Math.floor(i / SYSTEM_SIZE) + 1).padStart(2, '0')} · ${sizeOf(n).toUpperCase()}`]),
);

const shortHash = (s: string) => {
	let h = 2166136261;
	for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
	return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};

// git-graph rows for the list view: consecutive notes sharing a primary tag become a branch
type Row = { g: string; kind: string; note?: Post; label?: string; enc?: { id: string; label: string } };
const primary = (n: Post) => n.data.tags[0];
const rows: Row[] = [{ g: '*', kind: 'tip' }];
for (let i = 0; i < notes.length; ) {
	const tag = primary(notes[i]);
	let j = i;
	while (j < notes.length && primary(notes[j]) === tag) j++;
	const group = notes.slice(i, j);
	if (tag && group.length >= 2) {
		rows.push({ g: '|', kind: 'rail' }, { g: '|\\', kind: 'open', label: tag });
		for (const note of group) rows.push({ g: '| *', kind: 'commit', note });
		rows.push({ g: '|/', kind: 'close' });
	} else {
		for (const note of group) rows.push({ g: '|', kind: 'rail' }, { g: '*', kind: 'main', note });
	}
	i = j;
}
// the encrypted cores read as a locked branch — buttons, since they have no public page
if (cores.length) {
	rows.push({ g: '|', kind: 'rail' }, { g: '|\\', kind: 'open', label: 'encrypted' });
	for (const c of cores) rows.push({ g: '| *', kind: 'enc', enc: { id: c.id, label: c.label } });
	rows.push({ g: '|/', kind: 'close' });
}
rows.push({ g: '|', kind: 'rail' }, { g: '*', kind: 'root' });
---

<Base title="Notes" description={blurb} footer={false}>
	{
		!hasContent ? (
			<header class="page-head">
				<h1 data-decode>Notes</h1>
				<p>{blurb} Nothing out here yet — check back soon.</p>
			</header>
		) : (
			<div class="notes-page" data-view="map">
				<button class="view-toggle" type="button" data-toggle>list view</button>

				<section class="voyage" data-voyage style={`height:${trackVh}vh`} aria-hidden="true">
					<div class="viewport">
						<canvas class="ascii sky" data-hands data-notes={JSON.stringify(sky)} data-cores={JSON.stringify(cores)} data-vault={JSON.stringify(vault)} />
						<div class="hover-label" hidden />
						<button class="info-btn" type="button" data-info aria-expanded="false" aria-controls="legend-pop" aria-label="Key — what the planets mean">i</button>
						<div class="info-pop" id="legend-pop" data-info-pop hidden>
							<ul class="legend">
								<li><span class="dot moon" /> moon — a quick note (opens here)</li>
								<li><span class="dot planet" /> planet — a longer note (opens here)</li>
								<li><span class="dot giant" /> big planet — a full piece (its own page)</li>
								<li><span class="dot core" /> red core — an encrypted note (needs a passphrase)</li>
								<li class="sep">colour = how settled the idea is: <b class="s">seedling</b> · <b class="b">budding</b> · <b class="e">evergreen</b></li>
							</ul>
						</div>
					</div>
				</section>

				<div class="minimap" data-minimap aria-hidden="true">
					<div class="mm-dots" />
					<div class="mm-view" />
				</div>

				<aside class="sticky" hidden aria-live="polite">
					<span class="sticky-tape" aria-hidden="true" />
					<div class="sticky-paper">
						<button class="sticky-close" type="button" data-close aria-label="Close note">[ close ]</button>
						<p class="sticky-kicker">field note</p>
						<h2 class="sticky-title" />
						<div class="sticky-body prose" />
						<div class="sticky-lock" data-lock hidden>
							<p class="lock-hint">this thought is encrypted — enter the passphrase</p>
							<div class="lock-row">
								<input class="lock-input" type="password" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="passphrase" aria-label="passphrase" />
								<button class="lock-go" type="button" data-unlock>unlock</button>
							</div>
							<p class="lock-error" data-lock-error hidden />
						</div>
						<p class="sticky-meta"><span class="sticky-date" /><span class="sticky-coord" /></p>
					</div>
					<span class="sticky-dogear" aria-hidden="true" />
				</aside>

				<div class="list-view">
					<header class="page-head">
						<h1 data-decode>Notes</h1>
						<p>{blurb} Wander the map, or read the log. Brighter planets are more settled ideas.</p>
					</header>
					<div class="graph" role="list">
						{rows.map((r) =>
							r.note ? (
								<a class:list={['grow', r.kind]} href={postUrl(r.note)} role="listitem">
									<span class="rail" data-mat={r.note.data.maturity} aria-hidden="true">{r.g}</span>
									<span class="title">{r.note.data.title}</span>
									<span class="sha">{shortHash(r.note.id)}</span>
									<span class="stage">{r.note.data.maturity}</span>
								</a>
							) : r.kind === 'enc' ? (
								<button class:list={['grow', 'commit', 'enc']} data-enc-id={r.enc!.id} type="button" role="listitem">
									<span class="rail" aria-hidden="true">{r.g}</span>
									<span class="title">{r.enc!.label}</span>
									<span class="sha">[enc]</span>
									<span class="stage enc-lock">locked</span>
								</button>
							) : r.kind === 'open' ? (
								<p class="grow open" role="listitem">
									<span class="rail" aria-hidden="true">{r.g}</span>
									<span class="branch">{r.label}</span>
								</p>
							) : (
								<p class:list={['grow', r.kind]} aria-hidden="true">
									<span class="rail">{r.g}</span>
								</p>
							),
						)}
					</div>
				</div>

				{/* hidden rendered bodies for the sticky notes */}
				<div class="note-bodies" hidden>
					{bodies.map(({ note, Content }) => (
						<template data-body={note.id} data-title={note.data.title} data-meta={`${isoDate(note.data.pubDate)} · ${note.data.maturity}`} data-coord={coordOf.get(note.id)} data-url={postUrl(note)}>
							<Content />
						</template>
					))}
				</div>
			</div>
		)
	}
</Base>

<script>
	import { voyage, type Screen, type VNote } from '../../lib/voyage';
	import { decryptNote, type Vault } from '../../lib/decrypt';
	import { renderNote } from '../../lib/notemd';

	document.addEventListener('astro:page-load', () => {
		const page = document.querySelector<HTMLElement>('.notes-page');
		const canvas = document.querySelector<HTMLCanvasElement>('canvas.sky');
		const container = document.querySelector<HTMLElement>('.voyage');
		const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]');
		const label = document.querySelector<HTMLElement>('.hover-label');
		const sticky = document.querySelector<HTMLElement>('.sticky');
		if (!page || !canvas || !container || !toggle || !label || !sticky) return;

		// card refs
		const kicker = sticky.querySelector<HTMLElement>('.sticky-kicker')!;
		const titleEl = sticky.querySelector<HTMLElement>('.sticky-title')!;
		const bodyEl = sticky.querySelector<HTMLElement>('.sticky-body')!;
		const dateEl = sticky.querySelector<HTMLElement>('.sticky-date')!;
		const coordEl = sticky.querySelector<HTMLElement>('.sticky-coord')!;
		const lock = sticky.querySelector<HTMLElement>('[data-lock]')!;
		const lockInput = sticky.querySelector<HTMLInputElement>('.lock-input')!;
		const lockGo = sticky.querySelector<HTMLButtonElement>('[data-unlock]')!;
		const lockError = sticky.querySelector<HTMLElement>('[data-lock-error]')!;

		try {
			const saved = localStorage.getItem('notes:view');
			if (saved === 'list' || (!saved && matchMedia('(prefers-reduced-motion: reduce)').matches)) page.dataset.view = 'list';
		} catch {}
		const setView = (v: string) => {
			page.dataset.view = v;
			toggle.textContent = v === 'map' ? 'list view' : 'map view';
			try {
				localStorage.setItem('notes:view', v);
			} catch {}
		};
		toggle.textContent = page.dataset.view === 'map' ? 'list view' : 'map view';
		toggle.addEventListener('click', () => setView(page.dataset.view === 'map' ? 'list' : 'map'));

		// legend is behind an (i) button so it stays out of the way; click outside / Escape closes it
		const infoBtn = document.querySelector<HTMLButtonElement>('[data-info]');
		const infoPop = document.querySelector<HTMLElement>('[data-info-pop]');
		if (infoBtn && infoPop) {
			const setInfo = (v: boolean) => {
				infoPop.hidden = !v;
				infoBtn.setAttribute('aria-expanded', String(v));
			};
			infoBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				setInfo(infoPop.hidden);
			});
			document.addEventListener('click', (e) => {
				if (!infoPop.hidden && !infoPop.contains(e.target as Node)) setInfo(false);
			});
			addEventListener('keydown', (e) => e.key === 'Escape' && setInfo(false));
		}

		const notes = JSON.parse(canvas.dataset.notes ?? '[]') as VNote[];
		const coreData = JSON.parse(canvas.dataset.cores ?? '[]') as { sys: number; id: string; label: string }[];
		const vault = JSON.parse(canvas.dataset.vault ?? '[]') as Vault[];
		const vaultById = new Map(vault.map((e) => [e.id, e]));
		const coreById = new Map(coreData.map((c) => [c.id, c]));
		// encrypted cores for the engine (hover/click like planets)
		const cores = coreData.map((c) => ({
			sys: c.sys,
			note: { id: c.id, url: '', title: c.label, maturity: 'seedling', size: 'planet', mode: 'encrypted', locked: true } as VNote,
		}));

		const minimap = document.querySelector<HTMLElement>('[data-minimap]');
		const mmDots = minimap?.querySelector<HTMLElement>('.mm-dots');
		const mmView = minimap?.querySelector<HTMLElement>('.mm-view');
		let systems = 1;
		let open = false;
		// the shared passphrase lives ONLY here, in memory — never localStorage, never the DOM
		let sessionPass: string | null = null;
		let current: { note: VNote; entry: Vault; s: Screen | null } | null = null;

		// minimap: an overview strip of every body (by order), a window marking roughly what's on screen
		const syncView = () => {
			if (!mmView) return;
			const rect = container.getBoundingClientRect();
			const span = rect.height - innerHeight;
			const prog = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 0;
			const w = Math.min(1, Math.max(0.16, 1 / systems));
			mmView.style.left = `${prog * (1 - w) * 100}%`;
			mmView.style.width = `${w * 100}%`;
		};
		addEventListener('scroll', syncView, { passive: true });
		// click-and-hold to scrub the camera: seek to the pointer, then follow it while held
		if (minimap) {
			let scrub = false;
			const seek = (clientX: number) => {
				const r = minimap.getBoundingClientRect();
				const f = Math.min(1, Math.max(0, (clientX - r.left) / r.width));
				const vr = container.getBoundingClientRect();
				const top = vr.top + scrollY;
				scrollTo({ top: top + f * (container.offsetHeight - innerHeight), behavior: 'auto' });
			};
			minimap.addEventListener('pointerdown', (e) => {
				scrub = true;
				minimap.setPointerCapture(e.pointerId);
				seek(e.clientX);
			});
			minimap.addEventListener('pointermove', (e) => scrub && seek(e.clientX));
			const end = () => {
				scrub = false;
			};
			minimap.addEventListener('pointerup', end);
			minimap.addEventListener('pointercancel', end);
		}

		const placeCard = (s: Screen | null) => {
			sticky.hidden = false;
			const w = sticky.offsetWidth;
			const h = sticky.offsetHeight;
			let left: number;
			let top: number;
			if (s) {
				const right = s.x + s.r + 16;
				left = Math.min(right + w < innerWidth - 12 ? right : Math.max(12, s.x - s.r - 16 - w), innerWidth - w - 12);
				top = Math.max(12, Math.min(s.y - h / 2, innerHeight - h - 12));
			} else {
				left = Math.max(12, (innerWidth - w) / 2);
				top = Math.max(12, (innerHeight - h) / 2);
			}
			sticky.style.left = `${left}px`;
			sticky.style.top = `${top}px`;
		};

		const resetCard = () => {
			sticky.classList.remove('is-encrypted');
			lock.hidden = true;
			lockError.hidden = true;
			lockInput.value = '';
			bodyEl.hidden = false;
			titleEl.hidden = false;
		};

		const closeNote = () => {
			if (!open) return;
			open = false;
			current = null;
			sticky.hidden = true;
			resetCard();
			handle.setHeld(false);
		};

		const openSticky = (n: VNote, s: Screen) => {
			const tpl = document.querySelector<HTMLTemplateElement>(`template[data-body="${n.id}"]`);
			if (!tpl) return;
			resetCard();
			handle.setHeld(true);
			open = true;
			label.hidden = true;
			kicker.textContent = 'field note';
			titleEl.textContent = tpl.dataset.title ?? n.title;
			dateEl.textContent = tpl.dataset.meta ?? '';
			coordEl.textContent = tpl.dataset.coord ?? '';
			bodyEl.replaceChildren(tpl.content.cloneNode(true));
			placeCard(s);
		};

		const showContent = (title: string, body: string, s: Screen | null) => {
			kicker.textContent = 'decrypted';
			titleEl.textContent = title;
			titleEl.hidden = false;
			lock.hidden = true;
			bodyEl.hidden = false;
			renderNote(body, bodyEl);
			placeCard(s); // size changed, re-clamp
		};

		let busy = false;
		const tryDecrypt = async (pass: string) => {
			if (!current || busy) return;
			busy = true;
			const { note, entry, s } = current;
			lockGo.disabled = true;
			lockError.hidden = true;
			kicker.textContent = 'decrypting…';
			try {
				const plain = await decryptNote(entry, pass);
				if (!open || current?.note.id !== note.id) return; // closed/changed mid-decrypt
				sessionPass = pass;
				lockInput.value = ''; // don't leave the passphrase sitting in the DOM
				handle.markUnlocked?.(note.id);
				showContent(plain.title, plain.body, s);
			} catch (err) {
				if (!open || current?.note.id !== note.id) return;
				kicker.textContent = '[ encrypted ]';
				lock.hidden = false;
				bodyEl.hidden = true;
				lockError.hidden = false;
				lockError.textContent = (err as Error)?.message === 'insecure-context' ? 'needs a secure (https) connection' : 'wrong passphrase — try again';
				lockInput.focus();
				lockInput.select();
			} finally {
				lockGo.disabled = false;
				busy = false;
			}
		};

		const openEncrypted = (n: VNote, s: Screen | null, fromMap: boolean) => {
			const entry = vaultById.get(n.id);
			if (!entry) return;
			resetCard();
			if (fromMap) handle.setHeld(true);
			open = true;
			label.hidden = true;
			current = { note: n, entry, s };
			sticky.classList.add('is-encrypted');
			const core = coreById.get(n.id);
			coordEl.textContent = `SYS-${String((core ? core.sys : 0) + 1).padStart(2, '0')} · CORE`;
			dateEl.textContent = 'encrypted';
			kicker.textContent = '[ encrypted ]';
			titleEl.textContent = n.title;
			bodyEl.hidden = true;
			lock.hidden = false;
			lockError.hidden = true;
			lockInput.value = '';
			placeCard(s);
			if (sessionPass) tryDecrypt(sessionPass);
			else setTimeout(() => lockInput.focus(), 0);
		};

		const doUnlock = () => {
			if (!current) return;
			const pass = lockInput.value;
			if (!pass) {
				lockError.hidden = false;
				lockError.textContent = 'enter the passphrase';
				return;
			}
			tryDecrypt(pass);
		};
		lockGo.addEventListener('click', doUnlock);
		lockInput.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				e.preventDefault();
				doUnlock();
			}
		});

		const handle = voyage(canvas, notes, {
			container,
			cores,
			onLayout: (m) => {
				systems = Math.max(1, Math.ceil(m.planets.length / 3));
				if (!mmDots) return;
				const n = m.planets.length;
				mmDots.replaceChildren(
					...m.planets.map((pl, i) => {
						const dot = document.createElement('span');
						const enc = pl.note.mode === 'encrypted';
						dot.className = `mm-dot ${enc ? 'core' : pl.note.size}`;
						if (!enc) dot.dataset.mat = pl.note.maturity;
						dot.style.left = `${((i + 0.5) / n) * 92 + 4}%`;
						dot.style.top = `${22 + (i % 4) * 18}%`;
						dot.title = pl.note.title;
						return dot;
					}),
				);
				syncView();
			},
			onHover: (n, s) => {
				if (open) return;
				if (n && s) {
					label.hidden = false;
					label.textContent = n.mode === 'encrypted' ? `${n.title} · locked` : n.title;
					label.style.cssText = `left:${s.x}px;top:${s.y + s.r * 2.2 + 14}px`;
				} else {
					label.hidden = true;
				}
			},
			onOpen: (n, s) => {
				if (n.mode === 'page') location.href = n.url;
				else if (n.mode === 'encrypted') openEncrypted(n, s, true);
				else openSticky(n, s);
			},
			onClose: closeNote,
		});

		// list view: the encrypted rows have no page, so they open the unlock card centred
		for (const btn of document.querySelectorAll<HTMLElement>('[data-enc-id]')) {
			btn.addEventListener('click', () => {
				const c = coreById.get(btn.dataset.encId ?? '');
				if (c) openEncrypted({ id: c.id, url: '', title: c.label, maturity: 'seedling', size: 'planet', mode: 'encrypted', locked: true }, null, false);
			});
		}

		sticky.querySelector('[data-close]')?.addEventListener('click', closeNote);
		addEventListener('keydown', (e) => e.key === 'Escape' && closeNote());
		document.addEventListener('astro:before-swap', () => handle.destroy(), { once: true });
	});
</script>

<style>
	.view-toggle {
		position: fixed;
		top: 4.75rem;
		right: var(--gutter);
		z-index: 20;
		padding: 0.3rem 0.8rem;
		font: 0.8125rem var(--font-mono);
		color: var(--accent);
		background: var(--bg-raised);
		border: 1px solid var(--line);
	}

	.notes-page[data-view='map'] .list-view { display: none; }
	.notes-page[data-view='list'] .voyage,
	.notes-page[data-view='list'] .info-btn,
	.notes-page[data-view='list'] .info-pop,
	.notes-page[data-view='list'] .minimap { display: none !important; }

	/* minimap: overview of every system + a window for the camera; click-and-hold to scrub */
	.minimap {
		position: fixed;
		right: var(--gutter);
		bottom: 2.4rem;
		z-index: 12;
		width: min(13rem, 42vw);
		height: 3.5rem;
		background: color-mix(in srgb, var(--bg-raised) 85%, transparent);
		border: 1px solid var(--line);
		cursor: pointer;
		touch-action: none;
	}
	/* grabbable, so it speaks the site's glove-cursor language (splay to grab, palm on press) */
	@media (pointer: fine) {
		.minimap { cursor: url('/cursors/splay.svg') 14 15, grab; }
		.minimap:active { cursor: url('/cursors/palm.svg') 9 17, grabbing; }
	}
	.mm-dots { position: absolute; inset: 0; }
	.mm-dot {
		position: absolute;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 4px 0 color-mix(in srgb, var(--accent) 70%, transparent);
	}
	.mm-dot[data-mat='budding'] { background: var(--accent-2); box-shadow: 0 0 4px 0 color-mix(in srgb, var(--accent-2) 70%, transparent); }
	.mm-dot[data-mat='evergreen'] { background: var(--text-strong); box-shadow: 0 0 4px 0 color-mix(in srgb, var(--text-strong) 70%, transparent); }
	.mm-dot.moon { width: 4px; height: 4px; }
	.mm-dot.planet { width: 6px; height: 6px; }
	.mm-dot.giant { width: 9px; height: 9px; }
	.mm-dot.core { width: 8px; height: 8px; background: var(--hot); box-shadow: 0 0 5px 0 color-mix(in srgb, var(--hot) 75%, transparent); }

	.mm-view {
		position: absolute;
		top: 0;
		bottom: 0;
		border-left: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
		background: color-mix(in srgb, var(--accent) 7%, transparent);
		pointer-events: none;
	}

	.voyage {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-top: -4rem;
