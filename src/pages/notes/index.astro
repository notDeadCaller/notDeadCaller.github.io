---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, isoDate, postUrl, SECTIONS, type Post } from '../../site';

const SYSTEM_SIZE = 3; // keep in sync with voyage.ts
const notes = await getPosts('notes'); // newest first
const { blurb } = SECTIONS.notes;

// size by content length: short notes are moons that pop open as sticky notes; long ones are big
// planets that open their own page. colour stays with maturity.
const sizeOf = (n: Post) => {
	const len = (n.body ?? '').length;
	return len < 450 ? 'moon' : len < 1100 ? 'planet' : 'giant';
};
const sky = notes.map((n) => ({
	id: n.id,
	url: postUrl(n),
	title: n.data.title,
	maturity: n.data.maturity,
	size: sizeOf(n),
	mode: sizeOf(n) === 'giant' ? 'page' : 'sticky',
	locked: false,
}));
// render each bite-sized note once, hidden, so a sticky note can show it without a round trip
const bodies = await Promise.all(notes.filter((n) => sizeOf(n) !== 'giant').map(async (n) => ({ note: n, Content: (await render(n)).Content })));

const systems = Math.max(1, Math.ceil(notes.length / SYSTEM_SIZE));
const trackVh = Math.max(200, systems * 95);

const shortHash = (s: string) => {
	let h = 2166136261;
	for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
	return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};

// git-graph rows for the list view: consecutive notes sharing a primary tag become a branch
type Row = { g: string; kind: string; note?: Post; label?: string };
const primary = (n: Post) => n.data.tags[0];
const rows: Row[] = [{ g: '*', kind: 'tip' }];
for (let i = 0; i < notes.length; ) {
	const tag = primary(notes[i]);
	let j = i;
	while (j < notes.length && primary(notes[j]) === tag) j++;
	const group = notes.slice(i, j);
	if (tag && group.length >= 2) {
		rows.push({ g: '|', kind: 'rail' }, { g: '|\\', kind: 'open', label: tag });
		for (const note of group) rows.push({ g: '| *', kind: 'commit', note });
		rows.push({ g: '|/', kind: 'close' });
	} else {
		for (const note of group) rows.push({ g: '|', kind: 'rail' }, { g: '*', kind: 'main', note });
	}
	i = j;
}
rows.push({ g: '|', kind: 'rail' }, { g: '*', kind: 'root' });
---

<Base title="Notes" description={blurb} footer={false}>
	{
		notes.length === 0 ? (
			<header class="page-head">
				<h1 data-decode>Notes</h1>
				<p>{blurb} Nothing out here yet — check back soon.</p>
			</header>
		) : (
			<div class="notes-page" data-view="map">
				<button class="view-toggle" type="button" data-toggle>list view</button>

				<section class="voyage" data-voyage style={`height:${trackVh}vh`} aria-hidden="true">
					<div class="viewport">
						<canvas class="ascii sky" data-hands data-notes={JSON.stringify(sky)} />
						<div class="hover-ring" hidden />
						<div class="hover-label" hidden />
						<p class="hint">scroll to drift · hover a planet to focus it · click to open · a moon pops a note open here, a planet opens its page</p>
						<ul class="legend">
							<li><span class="dot moon" /> moon — a quick note (opens here)</li>
							<li><span class="dot planet" /> planet — a longer note (opens here)</li>
							<li><span class="dot giant" /> big planet — a full piece (its own page)</li>
							<li class="sep">colour = how settled the idea is: <b class="s">seedling</b> · <b class="b">budding</b> · <b class="e">evergreen</b></li>
						</ul>
					</div>
				</section>

				<div class="minimap" data-minimap aria-hidden="true">
					<div class="mm-dots" />
					<div class="mm-view" />
				</div>

				<aside class="sticky" hidden aria-live="polite">
					<button class="sticky-close" type="button" data-close aria-label="Close note">[ close ]</button>
					<p class="sticky-kicker">note</p>
					<h2 class="sticky-title" />
					<div class="sticky-body prose" />
					<p class="sticky-meta" />
				</aside>

				<div class="list-view">
					<header class="page-head">
						<h1 data-decode>Notes</h1>
						<p>{blurb} Wander the map, or read the log. Brighter planets are more settled ideas.</p>
					</header>
					<div class="graph" role="list">
						{rows.map((r) =>
							r.note ? (
								<a class:list={['grow', r.kind]} href={postUrl(r.note)} role="listitem">
									<span class="rail" data-mat={r.note.data.maturity} aria-hidden="true">{r.g}</span>
									<span class="title">{r.note.data.title}</span>
									<span class="sha">{shortHash(r.note.id)}</span>
									<span class="stage">{r.note.data.maturity}</span>
								</a>
							) : r.kind === 'open' ? (
								<p class="grow open" role="listitem">
									<span class="rail" aria-hidden="true">{r.g}</span>
									<span class="branch">{r.label}</span>
								</p>
							) : (
								<p class:list={['grow', r.kind]} aria-hidden="true">
									<span class="rail">{r.g}</span>
								</p>
							),
						)}
					</div>
				</div>

				{/* hidden rendered bodies for the sticky notes */}
				<div class="note-bodies" hidden>
					{bodies.map(({ note, Content }) => (
						<template data-body={note.id} data-title={note.data.title} data-meta={`${isoDate(note.data.pubDate)} · ${note.data.maturity}`} data-url={postUrl(note)}>
							<Content />
						</template>
					))}
				</div>
			</div>
		)
	}
</Base>

<script>
	import { voyage, type Screen, type VNote } from '../../lib/voyage';

	document.addEventListener('astro:page-load', () => {
		const page = document.querySelector<HTMLElement>('.notes-page');
		const canvas = document.querySelector<HTMLCanvasElement>('canvas.sky');
		const container = document.querySelector<HTMLElement>('.voyage');
		const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]');
		const ring = document.querySelector<HTMLElement>('.hover-ring');
		const label = document.querySelector<HTMLElement>('.hover-label');
		const sticky = document.querySelector<HTMLElement>('.sticky');
		if (!page || !canvas || !container || !toggle || !ring || !label || !sticky) return;

		try {
			const saved = localStorage.getItem('notes:view');
			if (saved === 'list' || (!saved && matchMedia('(prefers-reduced-motion: reduce)').matches)) page.dataset.view = 'list';
		} catch {}
		const setView = (v: string) => {
			page.dataset.view = v;
			toggle.textContent = v === 'map' ? 'list view' : 'map view';
			try {
				localStorage.setItem('notes:view', v);
			} catch {}
		};
		toggle.textContent = page.dataset.view === 'map' ? 'list view' : 'map view';
		toggle.addEventListener('click', () => setView(page.dataset.view === 'map' ? 'list' : 'map'));

		const notes = JSON.parse(canvas.dataset.notes ?? '[]');
		const minimap = document.querySelector<HTMLElement>('[data-minimap]');
		const mmDots = minimap?.querySelector<HTMLElement>('.mm-dots');
		const mmView = minimap?.querySelector<HTMLElement>('.mm-view');
		let systems = 1;
		let open = false;

		// minimap: an overview strip of every note (by order), a window marking roughly what's on screen
		const syncView = () => {
			if (!mmView) return;
			const rect = container.getBoundingClientRect();
			const span = rect.height - innerHeight;
			const prog = span > 0 ? Math.min(1, Math.max(0, -rect.top / span)) : 0;
			const w = Math.min(1, Math.max(0.16, 1 / systems));
			mmView.style.left = `${prog * (1 - w) * 100}%`;
			mmView.style.width = `${w * 100}%`;
		};
		addEventListener('scroll', syncView, { passive: true });
		minimap?.addEventListener('click', (e) => {
			const r = minimap.getBoundingClientRect();
			const f = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
			const vr = container.getBoundingClientRect();
			const top = vr.top + scrollY;
			scrollTo({ top: top + f * (container.offsetHeight - innerHeight), behavior: 'smooth' });
		});

		const closeNote = () => {
			if (!open) return;
			open = false;
			sticky.hidden = true;
			handle.setPaused(false);
		};
		const openSticky = (n: VNote, s: Screen) => {
			const tpl = document.querySelector<HTMLTemplateElement>(`template[data-body="${n.id}"]`);
			if (!tpl) return;
			handle.setPaused(true);
			open = true;
			ring.hidden = true;
			label.hidden = true;
			sticky.querySelector('.sticky-title')!.textContent = tpl.dataset.title ?? n.title;
			sticky.querySelector('.sticky-meta')!.textContent = tpl.dataset.meta ?? '';
			const body = sticky.querySelector<HTMLElement>('.sticky-body')!;
			body.replaceChildren(tpl.content.cloneNode(true));
			// place the card beside the planet, clamped to the viewport
			sticky.hidden = false;
			const w = sticky.offsetWidth;
			const h = sticky.offsetHeight;
			const right = s.x + s.r + 16;
			const left = right + w < innerWidth - 12 ? right : Math.max(12, s.x - s.r - 16 - w);
			sticky.style.left = `${Math.min(left, innerWidth - w - 12)}px`;
			sticky.style.top = `${Math.max(12, Math.min(s.y - h / 2, innerHeight - h - 12))}px`;
		};

		const handle = voyage(canvas, notes, {
			container,
			onLayout: (m) => {
				systems = Math.max(1, Math.ceil(m.planets.length / 3));
				if (!mmDots) return;
				const n = m.planets.length;
				mmDots.replaceChildren(
					...m.planets.map((pl, i) => {
						const dot = document.createElement('span');
						dot.className = `mm-dot ${pl.note.size}`;
						dot.dataset.mat = pl.note.maturity;
						dot.style.left = `${((i + 0.5) / n) * 92 + 4}%`;
						dot.style.top = `${22 + (i % 4) * 18}%`;
						dot.title = pl.note.title;
						return dot;
					}),
				);
				syncView();
			},
			onHover: (n, s) => {
				if (open) return;
				if (n && s) {
					ring.hidden = false;
					const d = s.r * 2 + 10;
					ring.style.cssText = `left:${s.x}px;top:${s.y}px;width:${d}px;height:${d}px`;
					label.hidden = false;
					label.textContent = n.title;
					label.style.cssText = `left:${s.x}px;top:${s.y + s.r + 12}px`;
				} else {
					ring.hidden = true;
					label.hidden = true;
				}
			},
			onOpen: (n, s) => {
				if (n.mode === 'page') location.href = n.url;
				else openSticky(n, s);
			},
		});

		sticky.querySelector('[data-close]')?.addEventListener('click', closeNote);
		addEventListener('keydown', (e) => e.key === 'Escape' && closeNote());
		document.addEventListener('astro:before-swap', () => handle.destroy(), { once: true });
	});
</script>

<style>
	.view-toggle {
		position: fixed;
		top: 4.75rem;
		right: var(--gutter);
		z-index: 20;
		padding: 0.3rem 0.8rem;
		font: 0.8125rem var(--font-mono);
		color: var(--accent);
		background: var(--bg-raised);
		border: 1px solid var(--line);
	}

	.notes-page[data-view='map'] .list-view { display: none; }
	.notes-page[data-view='list'] .voyage,
	.notes-page[data-view='list'] .hint,
	.notes-page[data-view='list'] .legend,
	.notes-page[data-view='list'] .minimap,
	.notes-page[data-view='list'] .sticky { display: none !important; }

	/* minimap: overview of every system + a window for the camera; click to jump */
	.minimap {
		position: fixed;
		right: var(--gutter);
		bottom: 2.4rem;
		z-index: 12;
		width: min(13rem, 42vw);
		height: 3.5rem;
		background: color-mix(in srgb, var(--bg-raised) 85%, transparent);
		border: 1px solid var(--line);
		cursor: pointer;
	}
	.mm-dots { position: absolute; inset: 0; }
	.mm-dot {
		position: absolute;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 4px 0 color-mix(in srgb, var(--accent) 70%, transparent);
	}
	.mm-dot[data-mat='budding'] { background: var(--accent-2); box-shadow: 0 0 4px 0 color-mix(in srgb, var(--accent-2) 70%, transparent); }
	.mm-dot[data-mat='evergreen'] { background: var(--text-strong); box-shadow: 0 0 4px 0 color-mix(in srgb, var(--text-strong) 70%, transparent); }
	.mm-dot.moon { width: 4px; height: 4px; }
	.mm-dot.planet { width: 6px; height: 6px; }
	.mm-dot.giant { width: 9px; height: 9px; }
	.mm-view {
		position: absolute;
		top: 0;
		bottom: 0;
		border-left: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
		background: color-mix(in srgb, var(--accent) 7%, transparent);
		pointer-events: none;
	}

	.voyage {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-top: -4rem;
	}
	.viewport {
		position: sticky;
		top: 0;
		height: 100vh;
		overflow: hidden;
	}
	.sky {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* focus ring + title appear only on a hovered planet */
	.hover-ring {
		position: fixed;
		z-index: 12;
		transform: translate(-50%, -50%);
		border: 1px solid var(--accent);
		border-radius: 50%;
		box-shadow: 0 0 12px 1px color-mix(in srgb, var(--accent) 60%, transparent);
		pointer-events: none;
	}
	.hover-label {
		position: fixed;
		z-index: 12;
		transform: translateX(-50%);
		padding: 0.15rem 0.5rem;
		white-space: nowrap;
		font: 0.8125rem var(--font-mono);
		color: var(--text-strong);
		background: var(--bg-raised);
		border: 1px solid var(--line);
		pointer-events: none;
	}

	.hint {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 1.1rem;
		z-index: 11;
		text-align: center;
		margin: 0;
		padding: 0 1rem;
		font: 0.72rem var(--font-mono);
		color: var(--muted);
		pointer-events: none;
	}

	.legend {
		position: fixed;
		left: var(--gutter);
		bottom: 2.6rem;
		z-index: 11;
		margin: 0;
		padding: 0;
		list-style: none;
		font: 0.72rem var(--font-mono);
		color: var(--muted);
		pointer-events: none;
	}
	.legend li { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.2rem; }
	.legend .sep { margin-top: 0.3rem; }
	.legend b { font-weight: 400; }
	.legend .s { color: var(--accent); }
	.legend .b { color: var(--accent-2); }
	.legend .e { color: var(--text-strong); }
	.legend .dot { display: inline-block; border-radius: 50%; background: var(--muted); }
	.legend .moon { width: 0.4rem; height: 0.4rem; }
	.legend .planet { width: 0.7rem; height: 0.7rem; }
	.legend .giant { width: 1rem; height: 1rem; }

	/* sticky note */
	.sticky {
		position: fixed;
		z-index: 25;
		width: min(22rem, calc(100vw - 2rem));
		max-height: 70vh;
		overflow: auto;
		padding: 1.1rem 1.25rem 1.4rem;
		background: var(--bg-raised);
		border: 1px solid var(--accent);
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
		clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1rem), calc(100% - 1rem) 100%, 0 100%);
	}
	.sticky-close {
		float: right;
		padding: 0;
		font: 0.75rem var(--font-mono);
		color: var(--muted);
		background: none;
		border: 0;
	}
	.sticky-close:hover { color: var(--accent); }
	.sticky-kicker { margin: 0; font: 600 0.75rem var(--font-mono); color: var(--accent); }
	.sticky-title { margin: 0.2rem 0 0.6rem; font-size: 1.2rem; }
	.sticky-body { font-size: 0.95rem; }
	.sticky-body :first-child { margin-top: 0; }
	.sticky-meta { margin: 0.8rem 0 0; font: 0.75rem var(--font-mono); color: var(--muted); }

	/* ---- git-graph list ---- */
	.page-head { margin-top: 2rem; }
	.graph { margin-top: 2rem; font-family: var(--font-mono); }
	.grow {
		display: grid;
		grid-template-columns: 3.5ch 1fr auto auto;
		align-items: baseline;
		gap: 0 0.9rem;
		margin: 0;
		text-decoration: none;
	}
	.grow .rail { color: var(--accent-2); white-space: pre; }
	.grow .rail[data-mat='evergreen'] { color: var(--text-strong); }
	a.grow { padding: 0.15rem 0; }
	a.grow:is(:hover, :focus-visible) .title { color: var(--accent); }
	.grow.rail, .grow.tip, .grow.root, .grow.close { line-height: 0.9; }
	.grow.tip .rail, .grow.root .rail { color: var(--text-strong); }
	.title { color: var(--text-strong); font-family: var(--font-body); }
	.sha { font-size: 0.8125rem; color: var(--muted); }
	.stage { font-size: 0.8125rem; color: var(--accent); }
	.open { grid-template-columns: 3.5ch 1fr; }
	.branch { color: var(--accent-2); }
	.branch::before { content: '⎇ '; }

	@media (max-width: 34em) {
		.grow { grid-template-columns: 3.5ch 1fr; }
		.sha { display: none; }
		.stage { grid-column: 2; justify-self: start; font-size: 0.75rem; }
		.legend { display: none; }
	}
</style>
