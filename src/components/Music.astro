---
// Background music. Persisted across page navigations by the client router, so playback never restarts.
const TRACK = { src: '/audio/raze-menu-theme.mp3', title: 'Menu Theme', artist: 'Coleman Trapp', from: 'Raze' };
---

<div class="music" transition:persist="music">
	<audio src={TRACK.src} loop preload="none"></audio>
	<button type="button" class="music-toggle" aria-pressed="false" aria-label="Play background music">
		<span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
		<span class="music-label">Sound</span>
	</button>
	<button type="button" class="music-info-toggle" popovertarget="music-info" aria-label="About the music">i</button>
	<div id="music-info" class="music-info" popover>
		<p class="mi-kicker">Now playing</p>
		<p class="mi-title">{TRACK.title}</p>
		<p class="mi-artist">{TRACK.artist} · from the game <em>{TRACK.from}</em></p>
		<label class="mi-volume">
			<span>Volume</span>
			<input type="range" min="0" max="0.6" step="0.01" value="0.22" />
			<output>37%</output>
		</label>
		<p class="mi-note">
			This <a href="https://www.youtube.com/watch?v=byzZBY3sugk">soundtrack</a> is from the original flash game <a href="https://armorgames.com/play/5395/raze">Raze</a>, a major childhood memory, and is used on this personal,
			non-commercial site purely for atmosphere and artistic expression. All rights remain with the composer; this site is
			not affiliated with or endorsed by them. For rightful removal request or any concerns kindly reach me on{' '}
			<a href="https://github.com/notDeadCaller">Github</a>.
		</p>
	</div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('.music');
	const audio = root?.querySelector('audio');
	const toggle = root?.querySelector<HTMLButtonElement>('.music-toggle');
	const slider = root?.querySelector<HTMLInputElement>('.mi-volume input');
	const readout = root?.querySelector('.mi-volume output');

	if (root && audio && toggle && slider) {
		let target = 0.22;
		try {
			const saved = Number(localStorage.getItem('music-volume'));
			if (saved > 0) target = saved;
		} catch {}
		slider.value = String(target);
		// paint the filled part of the meter and the percentage readout
		const show = () => {
			const pct = Math.round((Number(slider.value) / Number(slider.max)) * 100);
			slider.style.setProperty('--level', `${pct}%`);
			if (readout) readout.textContent = `${pct}%`;
		};
		show();

		let fadeId = 0;
		const fade = (to: number, ms: number, done?: () => void) => {
			cancelAnimationFrame(fadeId);
			const from = audio.volume;
			const start = performance.now();
			const step = (now: number) => {
				const k = Math.min(1, (now - start) / ms);
				audio.volume = from + (to - from) * k;
				if (k < 1) fadeId = requestAnimationFrame(step);
				else done?.();
			};
			fadeId = requestAnimationFrame(step);
		};

		const setPlaying = (playing: boolean) => {
			root.toggleAttribute('data-playing', playing);
			toggle.setAttribute('aria-pressed', String(playing));
			toggle.setAttribute('aria-label', playing ? 'Pause background music' : 'Play background music');
		};

		toggle.addEventListener('click', async () => {
			if (audio.paused) {
				audio.volume = 0;
				try {
					await audio.play();
					setPlaying(true);
					fade(target, 1800);
				} catch {}
			} else {
				setPlaying(false);
				fade(0, 600, () => audio.pause());
			}
		});

		slider.addEventListener('input', () => {
			target = Number(slider.value);
			show();
			if (!audio.paused) audio.volume = target;
			try {
				localStorage.setItem('music-volume', String(target));
			} catch {}
		});
	}
</script>

<style>
	.music {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font: 0.75rem var(--font-mono);
	}

	.music-toggle,
	.music-info-toggle {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.55rem;
		font: inherit;
		color: var(--muted);
		background: none;
		border: 1px solid var(--line);
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.music-toggle {
		clip-path: polygon(0 0, calc(100% - 6px) 0, 100% 6px, 100% 100%, 0 100%);
	}

	.music-toggle:hover,
	.music-info-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.music[data-playing] .music-toggle {
		color: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
	}

	.music-info-toggle {
		width: 1.65rem;
		justify-content: center;
		padding-inline: 0;
	}

	.bars {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 0.8rem;
	}

	.bars i {
		width: 2px;
		height: 30%;
		background: currentColor;
	}

	.music[data-playing] .bars i {
		background: var(--accent-2);
		animation: level 0.9s ease-in-out infinite alternate;
	}

	.music[data-playing] .bars i:nth-child(2) {
		animation-duration: 0.7s;
		animation-delay: -0.3s;
	}

	.music[data-playing] .bars i:nth-child(3) {
		animation-duration: 1.1s;
		animation-delay: -0.6s;
	}

	.music[data-playing] .bars i:nth-child(4) {
		animation-duration: 0.8s;
		animation-delay: -0.15s;
	}

	@keyframes level {
		from {
			height: 20%;
		}
		to {
			height: 100%;
		}
	}

	.music-info {
		--cut: 0.9rem;
		position: fixed;
		inset: 4.25rem var(--gutter) auto auto;
		width: min(22rem, calc(100vw - 2 * var(--gutter)));
		margin: 0;
		padding: 1.1rem 1.25rem 1rem;
		font: 0.75rem/1.6 var(--font-mono);
		color: var(--text);
		background: var(--bg-raised);
		border: 0;
		border-left: 2px solid var(--accent);
		clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
	}

	.music-info p {
		margin: 0;
	}

	.mi-kicker {
		color: var(--accent-2);
	}

	.mi-title {
		margin-top: 0.15rem !important;
		font: 700 1.5rem/1.1 var(--font-display);
		color: var(--text-strong);
	}

	.mi-artist {
		margin-top: 0.2rem !important;
		color: var(--muted);
	}

	.mi-volume {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0.9rem 0;
		color: var(--muted);
	}

	/* segmented level meter: filled segments up to --level, a slim yellow bar as the handle */
	.mi-volume input {
		--level: 37%;
		flex: 1;
		height: 1rem;
		margin: 0;
		background: transparent;
		appearance: none;
		cursor: pointer;
	}

	.mi-volume input::-webkit-slider-runnable-track {
		height: 0.55rem;
		background:
			repeating-linear-gradient(90deg, transparent 0 4px, var(--bg-raised) 4px 6px),
			linear-gradient(90deg, var(--accent-2) var(--level), var(--line) var(--level));
	}

	.mi-volume input::-moz-range-track {
		height: 0.55rem;
		background:
			repeating-linear-gradient(90deg, transparent 0 4px, var(--bg-raised) 4px 6px),
			linear-gradient(90deg, var(--accent-2) var(--level), var(--line) var(--level));
	}

	.mi-volume input::-webkit-slider-thumb {
		width: 4px;
		height: 1rem;
		margin-top: calc((0.55rem - 1rem) / 2);
		background: var(--accent);
		border: 0;
		border-radius: 0;
		appearance: none;
		box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 60%, transparent);
	}

	.mi-volume input::-moz-range-thumb {
		width: 4px;
		height: 1rem;
		background: var(--accent);
		border: 0;
		border-radius: 0;
		box-shadow: 0 0 6px color-mix(in srgb, var(--accent) 60%, transparent);
	}

	.mi-volume input:focus-visible {
		outline-offset: 4px;
	}

	.mi-volume output {
		min-width: 3ch;
		text-align: right;
		color: var(--accent);
	}

	.mi-note {
		padding-top: 0.75rem;
		font-size: 0.6875rem;
		color: var(--muted);
		border-top: 1px solid var(--line);
	}
</style>
